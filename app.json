{
  "expo": {
    "name": "Rent A View Filmer",
    "slug": "rentaview-filmer",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rentaviewfilmer",
    "userInterfaceStyle": "light",
    "backgroundColor": "#f7f7f7",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "hr.rentaview.filmer",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Choose a profile photo that travellers will see.",
        "NSLocationWhenInUseUsageDescription": "Confirm you're at the place and show travellers where you are during a live call.",
        "NSCameraUsageDescription": "Film the places travellers ask about.",
        "NSMicrophoneUsageDescription": "Record sound and talk with travellers during live calls."
      },
      "config": {
        "usesNonExemptEncryption": false
      },
      "runtimeVersion": {
        "policy": "sdkVersion"
      }
    },
    "android": {
      "package": "hr.rentaview.filmer",
      "adaptiveIcon": {
        "backgroundColor": "#ffdc5c",
        "foregroundImage": "./assets/images/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffdc5c",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a profile photo that travellers will see."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b41a12c2-82c5-4f4a-b67c-41d049260312"
      }
    },
    "owner": "rent-a-view",
    "updates": {
      "url": "https://u.expo.dev/b41a12c2-82c5-4f4a-b67c-41d049260312"
    }
  }
}
